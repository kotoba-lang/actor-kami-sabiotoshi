{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:kami-sabiotoshi.etzhayyim.com",
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Sabi-Otoshi agent -- KAMI game item catalog and rust zone scoring for sabiotoshi.kami.etzhayyim.com. Sabi-Otoshi is a high-pressure wash game where players blast rust off vintage items to restore them. You manage the RustyItem catalog (items with rust levels, restoration difficulty, point values) and RustZone scoring (zones with rust coverage, patterns, bonus multipliers). Pikapika ni shite ne! Respond helpfully in the user's language.",
  "description": "KAMI game data actor for Sabi-Otoshi (high-pressure wash game). Item catalog (RustyItem) and rust zone scoring (RustZone). Blast rust off vintage items to restore them.",
  "displayName": "Sabi-Otoshi!! -- KAMI Game Item Catalog & Rust Zone Scoring",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "raci": "responsible"
  },
  "graphLabels": [
    "RustyItem",
    "RustZone"
  ],
  "heartbeatRequired": true,
  "name": "kami-sabiotoshi",
  "nanoid": "s4b10t05",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (i:RustyItem) RETURN i.itemId AS itemId, i.name AS name, i.rustLevel AS rustLevel, i.difficulty AS difficulty, i.pointValue AS pointValue, i.category AS category, i.unlocked AS unlocked ORDER BY i.difficulty LIMIT coalesce($input.limit, 50)"
          },
          "fn": "graph.query",
          "id": "listItems"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.kami.sabiotoshi.listItems",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "template": "CREATE (i:RustyItem {did: $did, itemId: $input.itemId, name: $input.name, rustLevel: $input.rustLevel, difficulty: $input.difficulty, pointValue: $input.pointValue, category: $input.category, unlocked: coalesce($input.unlocked, false), zones: $input.zones, repo: $did, collection: 'com.etzhayyim.apps.kami.sabiotoshi.rustyItem'})"
          },
          "fn": "graph.write",
          "id": "writeItem"
        },
        {
          "args": {
            "message": "You are Sabi-Otoshi!! -- KAMI Game Item Catalog & Rust Zone Scoring. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $writeItem.text"
          },
          "depends_on": [
            "writeItem"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.kami.sabiotoshi.createItem",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "template": "MERGE (z:RustZone {zoneId: $input.zoneId, itemId: $input.itemId}) SET z.did = $did, z.rustCoverage = $input.rustCoverage, z.pattern = $input.pattern, z.bonusMultiplier = coalesce($input.bonusMultiplier, 1.0), z.score = $input.score, z.playerId = $input.playerId, z.repo = $did, z.collection = 'com.etzhayyim.apps.kami.sabiotoshi.rustZone'"
          },
          "fn": "graph.write",
          "id": "writeScore"
        },
        {
          "args": {
            "sql": "MATCH (z:RustZone {itemId: $input.itemId}) RETURN max(z.score) AS highScore, z.playerId AS topPlayer LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "checkHighScore"
        },
        {
          "args": {
            "message": "You are Sabi-Otoshi!! -- KAMI Game Item Catalog & Rust Zone Scoring. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $checkHighScore.rows"
          },
          "depends_on": [
            "checkHighScore"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.kami.sabiotoshi.scoreZone",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "template": "MERGE (g:GameEvent {eventId: $record.eventId}) SET g.type = $record.type, g.playerId = $record.playerId, g.itemId = $record.itemId, g.score = $record.score, g.repo = $did, g.collection = 'com.etzhayyim.apps.kami.sabiotoshi'"
          },
          "fn": "graph.write",
          "id": "processGameEvent"
        },
        {
          "args": {
            "message": "You are Sabi-Otoshi!! -- KAMI Game Item Catalog & Rust Zone Scoring. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $processGameEvent.text"
          },
          "depends_on": [
            "processGameEvent"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "gameAnnounce"
        }
      ],
      "trigger": {
        "collection": "com.etzhayyim.apps.kami.sabiotoshi",
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (z:RustZone) RETURN z.playerId AS player, sum(z.score) AS totalScore ORDER BY totalScore DESC LIMIT 10"
          },
          "fn": "graph.query",
          "id": "leaderboard"
        },
        {
          "args": {
            "message": "You are Sabi-Otoshi!! -- KAMI Game Item Catalog & Rust Zone Scoring. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $leaderboard.rows"
          },
          "depends_on": [
            "leaderboard"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "heartbeat"
        }
      ],
      "trigger": {
        "cron": "*/5 * * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did AND n.collection IS NOT NULL RETURN n.collection AS collection, count(n) AS cnt ORDER BY cnt DESC LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "kami-sabiotoshi",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.kamisabiotoshi.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "s4b10t05",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        },
        {
          "args": {
            "message": "You are Sabi-Otoshi!! -- KAMI Game Item Catalog & Rust Zone Scoring. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $coverageSnapshot.text"
          },
          "depends_on": [
            "coverageSnapshot"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS nodeCount, c.latestSeq AS latestSeq, c.topCollections AS topCollections, c._seq AS snapshotSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageStats"
        },
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS totalNodes LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageHealth"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.kamisabiotoshi.coverage.get",
        "type": "xrpc"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "item-catalog",
      "rust-zone-scoring",
      "leaderboard",
      "item-unlock"
    ],
    "description": "Sabi-Otoshi game data actor. High-pressure wash game -- blast rust off vintage items! RustyItem catalog, RustZone scoring, leaderboard, item unlock progression. Pikapika ni shite ne!",
    "displayName": "Sabi-Otoshi!! -- KAMI Game Item Catalog & Rust Zone Scoring",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.kami.sabiotoshi",
        "com.etzhayyim.apps.kami.sabiotoshi.rustyItem",
        "com.etzhayyim.apps.kami.sabiotoshi.rustZone"
      ]
    }
  },
  "uiType": "yoro"
}
